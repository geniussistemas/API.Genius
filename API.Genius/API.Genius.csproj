  <!-- Copia o template de config na pasta de build para que seja utilizado em novas instalações -->
  <!-- Target que roda após a compilação -->
  <Target Name="AfterBuildConfigTemplate" AfterTargets="Build">
    <Copy SourceFiles="appsettings.Production.json.template" DestinationFiles="$(OutputPath)appsettings.Production.json.template" />
    <!-- <Copy SourceFiles="$(OutputPath)appsettings.Production.json.template" DestinationFiles="$(OutputPath)appsettings.Production.json.template" /> -->
