<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>6f0061df-c022-43dc-827a-f5ec29e940f0</UserSecretsId>
    <ApplicationIcon>Setup.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Setup.ico" />

    <!-- Exclui configurações de desenvolvimento do publish -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />

    <!-- Exclui configurações de produçao do publish -->
    <Content Update="appsettings.Production.json" CopyToPublishDirectory="Never" />

    <!-- Copia template de configuração de Production no publish -->
    <Content Include="appsettings.Production.json.template" CopyToPublishDirectory="PreserveNewest" />

    <!-- Exclui pasta de logs do publish -->
    <Content Remove="logs\**" />

    <!-- Inclui arquivos de migration de banco de dados no publish -->
    <None Include="migration\**" CopyToPublishDirectory="PreserveNewest" />

  </ItemGroup>

  <ItemGroup>
<!--    <PackageReference Include="mercadopago-sdk" Version="2.4.0" /> -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.6" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\API.Genius.Core\API.Genius.Core.csproj" />
    <ProjectReference Include="..\API.Genius.Lib\API.Genius.Lib.csproj" />
  </ItemGroup>

